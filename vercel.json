{
  "framework": "vite",
  "buildCommand": "npx vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/area/:token",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|WhatsApp|Twitterbot|LinkedInBot|Slackbot|TelegramBot|Discordbot|Googlebot|Bingbot|Pinterest|redditbot|SkypeUriPreview).*"
        }
      ],
      "destination": "/api/og-preview?token=:token"
    },
    {
      "source": "/area/:token/:rest*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|WhatsApp|Twitterbot|LinkedInBot|Slackbot|TelegramBot|Discordbot|Googlebot|Bingbot|Pinterest|redditbot|SkypeUriPreview).*"
        }
      ],
      "destination": "/api/og-preview?token=:token"
    },
    {
      "source": "/questionario/:token",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|WhatsApp|Twitterbot|LinkedInBot|Slackbot|TelegramBot|Discordbot|Googlebot|Bingbot|Pinterest|redditbot|SkypeUriPreview).*"
        }
      ],
      "destination": "/api/og-preview?token=:token&tipo=questionario"
    },
    {
      "source": "/orcamento/:token",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|WhatsApp|Twitterbot|LinkedInBot|Slackbot|TelegramBot|Discordbot|Googlebot|Bingbot|Pinterest|redditbot|SkypeUriPreview).*"
        }
      ],
      "destination": "/api/og-preview?token=:token&tipo=orcamento"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/lembretes-agendamento",
      "schedule": "0 11 * * *"
    }
  ]
}